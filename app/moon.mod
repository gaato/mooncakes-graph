name = "gaato/mooncakes-graph"

version = "0.1.0"

import {
  "moonbit-community/rabbita@0.16.5",
  "gaato/mooncakes_index@0.1.0",
  "gaato/force@0.1.0",
  "cli/core@0.6.0",
  "moonbitlang/x@0.5.5",
}

readme = "README.md"

repository = "https://github.com/gaato/mooncakes-graph"

license = "Apache-2.0"

keywords = [ "mooncakes", "dependency-graph", "visualization" ]

description = "Dependency graph of the mooncakes.io registry: a web map and a tree-like CLI."

preferred_target = "js"
